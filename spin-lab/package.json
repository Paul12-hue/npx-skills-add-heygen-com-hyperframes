{
  "name": "spin-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SPIN LAB — The Science of Impossible Spin. A 3D table tennis physics arcade game.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "solve": "tsx tools/solve.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
