# SQLite für lokale Entwicklung; für Produktion z. B. PostgreSQL (provider in prisma/schema.prisma anpassen)
DATABASE_URL="file:./dev.db"
# Mindestens 32 zufällige Zeichen: openssl rand -base64 48
SESSION_SECRET="bitte-ersetzen-durch-einen-langen-zufaelligen-wert-0123456789"
# Token für automatischen Import (OCR-Agent, Cron). Leer = Import-API deaktiviert.
INGEST_TOKEN="bitte-ersetzen-ingest-token"
# Token für den Cron-Aufruf der Erinnerungen
CRON_TOKEN="bitte-ersetzen-cron-token"
